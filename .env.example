# ── Pexels (여행지 사진, 빌드/로컬 스크립트 전용 — VITE_ 붙이지 마세요) ──
# https://www.pexels.com/api/ 무료 키 → node scripts/fetch-pexels-images.mjs
# PEXELS_API_KEY=your_pexels_api_key

# ── OpenAI (AI 일정 생성) ──
VITE_OPENAI_API_KEY=your_openai_api_key
VITE_OPENAI_MODEL=gpt-4o-mini

# ── 사이트 URL (선택 — 결제 복귀는 요청 origin 우선, OG 등에 사용) ──
# 로컬 테스트 시 localhost로 돌아옵니다. 배포 OG용으로만 설정해도 됩니다.
# VITE_SITE_URL=https://my-travel-flax.vercel.app

# ── 포트원 / 나이스페이 결제 (Server 승인) ──
# docs/PORTONE_NICEPAY_SETUP.md 참고
# 브라우저용 (VITE_ 필수). 서버 API도 동일 변수를 읽습니다.
# VITE_PORTONE_CLIENT_KEY=S2_...
# PORTONE_SECRET_KEY=...
# NICEPAY_SANDBOX=true

# Upstash Redis (Vercel에서 주문 상태 — 권장)
# KV_REST_API_URL=...
# KV_REST_API_TOKEN=...

# ── Paddle 결제 (대안) ──
# https://vendors.paddle.com → Developer tools → Authentication
# 클라이언트 토큰 (브라우저)
VITE_PADDLE_CLIENT_TOKEN=test_...
# Catalog → Price ID (990원 일회)
VITE_PADDLE_PRICE_ID=pri_...
# sandbox | production
VITE_PADDLE_ENV=sandbox
# API 키 (서버 전용, VITE_ 붙이지 마세요)
PADDLE_API_KEY=...
PADDLE_ENV=sandbox

# ── 토스 QR (기본: QR 모달 → 송금 완료 → 일정 열기) ──
# public/toss-payment-qr.png 에 QR 이미지 넣기

# 토스페이 QR 직접 + 자동 승인 (API 개별 키 test_ck — gck는 결제수단 선택창만 뜸)
# VITE_PAYMENT_TOSS_AUTO=true
# VITE_TOSS_CLIENT_KEY=test_ck_...
# TOSS_SECRET_KEY=test_sk_...

# ── 수요 검증 (무료 체험, QR 끄려면 false) ──
# VITE_PAYMENT_DEMAND_TEST=false

# ── 토스페이먼츠 (레거시, Paddle 사용 시 불필요) ──
# VITE_TOSS_CLIENT_KEY=test_gck_...
# TOSS_SECRET_KEY=test_gsk_...

# ── 관리자 도구 (홈 화면 랜덤 결과 바로가기, 로컬·스테이징만 설정 권장) ──
# VITE_ADMIN_KEY=your_secret_admin_key
# 잠금 해제: 홈에서「관리자」클릭 후 키 입력, 또는 ?admin=your_secret_admin_key
