# ── OpenAI (AI 일정 생성) ──
VITE_OPENAI_API_KEY=your_openai_api_key
VITE_OPENAI_MODEL=gpt-4o-mini

# ── 사이트 URL (선택, OG 등 — 결제 리다이렉트는 현재 접속 URL 자동 사용) ──
# VITE_SITE_URL=https://my-travel-flax.vercel.app

# ── 토스페이먼츠 결제위젯 v2 (https://docs.tosspayments.com) ──
# npm: @tosspayments/tosspayments-sdk
# 개발자센터 → API 키 → 결제위젯 연동 키 → 클라이언트 키
VITE_TOSS_CLIENT_KEY=test_gck_docs_Ovk5rk1EwkEbP0W43n07xlzm
# 결제위젯 연동 키 → 시크릿 키 (서버 전용, VITE_ 붙이지 마세요)
TOSS_SECRET_KEY=test_gsk_docs_OaPz8L5KdmQXkzRz3y47BMw6

# 전자결제 신청 후 실제 키로 교체:
# VITE_TOSS_CLIENT_KEY=live_gck_...
# TOSS_SECRET_KEY=live_gsk_...

# ── 테스트 모드 (true면 결제 없이 진행) ──
# VITE_PAYMENT_MOCK=true

# ── 관리자 도구 (홈 화면 랜덤 결과 바로가기, 로컬·스테이징만 설정 권장) ──
# VITE_ADMIN_KEY=your_secret_admin_key
# 잠금 해제: 홈에서「관리자」클릭 후 키 입력, 또는 ?admin=your_secret_admin_key
